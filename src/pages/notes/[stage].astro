---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllNotes, getStageNeighbours } from '../../../utils/notes';

/**
 * 单章笔记页：/notes/S00/ 只列该章节的笔记，不混入其他章节。
 * 由 [stage].astro + getStaticPaths 在 build 时为每个章节生成一个静态页。
 */
export function getStaticPaths() {
  const { stages } = getAllNotes();
  return stages.map((stage) => ({ params: { stage: stage.id } }));
}

const { stage: stageId } = Astro.params;
const { stages } = getAllNotes();
const stage = stages.find((s) => s.id === stageId)!;
const { prev, next } = getStageNeighbours(stageId!);
const stageIndex = stages.findIndex((s) => s.id === stageId);
---

<BaseLayout
  title={`${stage.id} ${stage.title}`}
  description={`${stage.title} —— 共 ${stage.notes.length} 篇投资笔记。`}
>
  <section class="container container--narrow">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/notes/">所有笔记</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{stage.id}</span>
    </nav>

    <header class="page-header">
      <p class="page-header__eyebrow">
        STAGE {stageIndex} / {stages.length - 1}
      </p>
      <h1>
        <span class="page-header__id">{stage.id}</span>
        {stage.title}
      </h1>
      <p class="page-header__lead">
        本章共 <strong>{stage.notes.length}</strong> 篇笔记。
        <a class="page-header__all" href="/notes/">查看全部 {stages.reduce((n, s) => n + s.notes.length, 0)} 篇 →</a>
      </p>
    </header>

    <ol class="note-list">
      {stage.notes.map((note) => (
        <li>
          <a class="note-list__link" href={`/notes/${note.slug}`}>
            <span class="note-list__num">{note.num}</span>
            <span class="note-list__title">{note.title}</span>
            <span class="note-list__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <nav class="stage-pager" aria-label="章节翻页">
      {prev ? (
        <a class="stage-pager__link stage-pager__link--prev" href={`/notes/${prev.id}/`}>
          <span class="stage-pager__label">上一章</span>
          <span class="stage-pager__title">
            <span class="stage-pager__id">{prev.id}</span> {prev.title}
          </span>
        </a>
      ) : (
        <span />
      )}

      {next ? (
        <a class="stage-pager__link stage-pager__link--next" href={`/notes/${next.id}/`}>
          <span class="stage-pager__label">下一章</span>
          <span class="stage-pager__title">
            <span class="stage-pager__id">{next.id}</span> {next.title}
          </span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .page-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 2px solid var(--accent);
  }

  .page-header__eyebrow {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .page-header h1 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    font-size: 2rem;
    letter-spacing: -0.02em;
  }

  .page-header__id {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-subtle);
    padding: 2px 10px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .page-header__lead {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .page-header__all {
    margin-left: var(--space-3);
    color: var(--accent);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .page-header__all:hover {
    text-decoration: underline;
  }

  .note-list {
    list-style: none;
    margin: 0 0 var(--space-10);
    padding: 0;
  }

  .note-list li {
    margin: 0;
    border-bottom: 1px dashed var(--border-default);
  }

  .note-list li:last-child {
    border-bottom: none;
  }

  .note-list__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .note-list__link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .note-list__num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent);
    min-width: 28px;
    flex-shrink: 0;
  }

  .note-list__title {
    flex: 1;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .note-list__arrow {
    color: var(--text-muted);
    font-size: 0.875rem;
    opacity: 0;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .note-list__link:hover .note-list__arrow {
    opacity: 1;
    transform: translateX(4px);
    color: var(--accent);
  }

  .stage-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-default);
  }

  .stage-pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .stage-pager__link:hover {
    border-color: var(--accent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .stage-pager__link--next {
    text-align: right;
  }

  .stage-pager__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .stage-pager__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .stage-pager__link:hover .stage-pager__title {
    color: var(--accent);
  }

  .stage-pager__id {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .page-header h1 { font-size: 1.5rem; }
    .stage-pager { grid-template-columns: 1fr; }
    .stage-pager__link--next { text-align: left; }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllNotes } from '../../utils/notes';

/**
 * 笔记索引页：Astro build 时扫描 public/notes/ 下的所有 HTML 文件，
 * 按章节前缀（S00-S13）分组列出。笔记正文是独立 HTML（深色主题），
 * 不经过 Astro 处理；这里只负责目录和导航。
 *
 * 单章视图用 URL query 参数实现，避免动态路由：
 *   /notes/            → 全部 115 篇
 *   /notes/?stage=S00  → 只显示 S00 章的 9 篇
 * 脚本（is:inline）在客户端读取 ?stage= 后隐藏其他章节，
 * 因此静态构建即可工作，不需要为每章生成单独页面。
 */
const { stages, all: notes } = getAllNotes();
const totalNotes = notes.length;
const totalStages = stages.length;
---

<BaseLayout
  title="所有笔记"
  description="覆盖散户投资认知、技术分析、财报估值、仓位管理、市场周期与情绪等 14 个章节，共 115 篇投资笔记。"
>
  <section class="container notes-page">
    <header class="page-header">
      <p class="page-header__eyebrow">NOTES · 投资笔记合集</p>
      <h1>所有笔记</h1>
      <p class="page-header__lead">
        共 <strong>{totalNotes}</strong> 篇笔记，按章节（S00–S13）分组排列。
        每篇均为独立深色主题页面，包含完整目录、实战案例与图表。
      </p>
      <div class="page-header__stats" data-header-stats>
        <span class="stat-pill"><b>{totalNotes}</b> 篇笔记</span>
        <span class="stat-pill"><b>{totalStages}</b> 个章节</span>
      </div>
    </header>

    <nav class="stage-filter" aria-label="按章节筛选">
      <a class="stage-filter__chip" href="/notes/" data-stage-chip data-stage-title="全部笔记">全部</a>
      {stages.map((stage) => (
        <a
          class="stage-filter__chip"
          href={`/notes/?stage=${stage.id}`}
          data-stage-chip={stage.id}
          data-stage-title={stage.title}
        >
          <span class="stage-filter__id">{stage.id}</span>
          {stage.title.split(' · ')[0]}
        </a>
      ))}
    </nav>

    <div id="stage-view" data-all-count={totalNotes}>
      {stages.map((stage) => (
        <section class="stage-group" id={stage.id} data-stage={stage.id}>
          <h2 class="stage-group__title">
            <a class="stage-group__link" href={`/notes/?stage=${stage.id}`}>
              <span class="stage-group__id">{stage.id}</span>
              <span class="stage-group__name">{stage.title}</span>
              <span class="stage-group__count">{stage.notes.length} 篇</span>
              <span class="stage-group__go" aria-hidden="true">只看本章 →</span>
            </a>
          </h2>
          <ol class="note-list">
            {stage.notes.map((note) => (
              <li>
                <a class="note-list__link" href={`/notes/${encodeURIComponent(note.slug)}`}>
                  <span class="note-list__num">{note.num}</span>
                  <span class="note-list__title">{note.title}</span>
                  <span class="note-list__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <p class="stage-empty" data-stage-empty hidden>该章节没有笔记。</p>
  </section>

  <script is:inline>
    // 单章视图：/notes/?stage=S00 只显示 S00 章，其余章节隐藏。
    // 静态构建产物里所有章节都在 HTML 中，由这里按参数过滤。
    (function () {
      var view = document.getElementById('stage-view');
      if (!view) return;

      var stage = new URLSearchParams(location.search).get('stage');
      var groups = Array.prototype.slice.call(
        view.querySelectorAll('[data-stage]')
      );
      var chips = Array.prototype.slice.call(
        document.querySelectorAll('[data-stage-chip]')
      );
      var lead = document.querySelector('.page-header__lead');
      var h1 = document.querySelector('.page-header h1');
      var stats = document.querySelector('[data-header-stats]');

      if (!stage) {
        // 全部视图：给「全部」chip 加高亮
        chips.forEach(function (c) {
          if (!c.getAttribute('data-stage-chip')) c.classList.add('is-active');
        });
        return;
      }

      var matched = 0;
      groups.forEach(function (g) {
        var on = g.getAttribute('data-stage') === stage;
        g.hidden = !on;
        if (on) matched += 1;
      });

      chips.forEach(function (c) {
        if (c.getAttribute('data-stage-chip') === stage) c.classList.add('is-active');
      });

      if (matched === 0) {
        var empty = document.querySelector('[data-stage-empty]');
        if (empty) empty.hidden = false;
      }

      if (h1) {
        var active = document.querySelector('[data-stage-chip="' + stage + '"]');
        var name = active ? active.getAttribute('data-stage-title') : stage;
        h1.textContent = stage + ' · ' + (name || stage);
      }

      if (lead) {
        var visible = view.querySelector('[data-stage="' + stage + '"]');
        var n = visible ? visible.querySelectorAll('.note-list__link').length : 0;
        lead.textContent = '本章共 ' + n + ' 篇笔记。';
      }

      // 单章视图下总览统计不再适用，隐藏以免与上方计数矛盾
      if (stats) stats.hidden = true;
    })();
  </script>
</BaseLayout>

<style>
  .notes-page {
    padding-bottom: var(--space-8);
  }

  /* ---------- 页头 ---------- */
  .page-header {
    position: relative;
    margin-bottom: var(--space-6);
    padding: var(--space-6) var(--space-6) var(--space-5);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(45, 212, 191, 0.08), transparent 60%),
      var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
  }

  .page-header__eyebrow {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .page-header h1 {
    margin: 0 0 var(--space-3);
    font-size: 2.25rem;
    letter-spacing: -0.02em;
  }

  .page-header__lead {
    margin: 0;
    max-width: 44em;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .page-header__lead strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .page-header__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .page-header__stats[hidden] {
    display: none;
  }

  .stat-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.2rem 0.7rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-default);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .stat-pill b {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--accent);
  }

  /* ---------- 章节筛选（吸顶） ---------- */
  .stage-filter {
    position: sticky;
    top: 64px;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 calc(-1 * var(--space-6)) var(--space-6);
    padding: var(--space-3) var(--space-6);
    background: color-mix(in srgb, var(--bg-page) 88%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border-default);
  }

  .stage-filter__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.3rem var(--space-3);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .stage-filter__chip:hover {
    color: var(--accent-hover);
    border-color: var(--accent);
    background: var(--accent-subtle);
    text-decoration: none;
  }

  .stage-filter__chip.is-active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
    font-weight: 600;
    box-shadow: 0 0 0 1px var(--accent-subtle);
  }

  .stage-filter__id {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  /* ---------- 章节卡片 ---------- */
  .stage-group {
    position: relative;
    margin-bottom: var(--space-5);
    padding: var(--space-4) var(--space-5) var(--space-3);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .stage-group:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .stage-group::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    background: linear-gradient(180deg, var(--accent), rgba(45, 212, 191, 0.04));
  }

  .stage-group[hidden] {
    display: none;
  }

  .stage-group__title {
    margin: 0 0 var(--space-3);
    font-size: 1.125rem;
  }

  .stage-group__link {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-1);
    border-bottom: 1px solid var(--border-default);
    color: inherit;
    text-decoration: none;
  }

  .stage-group__link:hover {
    text-decoration: none;
  }

  .stage-group__id {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  .stage-group__name {
    flex: 1;
    min-width: 0;
    color: var(--text-primary);
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .stage-group__link:hover .stage-group__name {
    color: var(--accent-hover);
  }

  .stage-group__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .stage-group__go {
    font-size: 0.75rem;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    white-space: nowrap;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .stage-group__link:hover .stage-group__go {
    opacity: 1;
    transform: translateX(0);
  }

  /* ---------- 笔记条目 ---------- */
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .note-list li {
    margin: 0;
  }

  .note-list__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    text-decoration: none;
    transition: background var(--transition-fast), box-shadow var(--transition-fast);
  }

  .note-list__link:hover {
    background: var(--bg-subtle);
    box-shadow: inset 2px 0 0 var(--accent);
    text-decoration: none;
  }

  .note-list__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 2.1rem;
    padding: 0.1rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-subtle);
    border-radius: var(--radius-sm);
  }

  .note-list__title {
    flex: 1;
    min-width: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    transition: color var(--transition-fast);
  }

  .note-list__link:hover .note-list__title {
    color: var(--accent-hover);
  }

  .note-list__arrow {
    flex-shrink: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    opacity: 0.35;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .note-list__link:hover .note-list__arrow {
    opacity: 1;
    transform: translateX(3px);
    color: var(--accent);
  }

  .stage-empty {
    padding: var(--space-8);
    text-align: center;
    color: var(--text-muted);
    background: var(--bg-subtle);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--border-default);
  }

  @media (max-width: 640px) {
    .page-header {
      padding: var(--space-5) var(--space-4) var(--space-4);
    }

    .page-header h1 {
      font-size: 1.75rem;
    }

    .stage-filter {
      top: 56px;
      padding: var(--space-3) var(--space-6);
    }

    .stage-group {
      padding: var(--space-4) var(--space-4) var(--space-2);
    }

    .stage-group__title {
      font-size: 1rem;
    }

    .stage-group__go {
      display: none;
    }

    .note-list__link {
      padding: var(--space-2);
    }
  }
</style>

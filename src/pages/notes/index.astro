---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllNotes } from '../../utils/notes';

/**
 * 笔记总索引：在 Astro build 时扫描 public/notes/ 下的所有 HTML 文件，
 * 按章节前缀（S00-S13）分组列出。笔记正文是独立 HTML（深色主题），
 * 不经过 Astro 处理；这里只负责目录和导航。
 *
 * 每章另有独立页面 /notes/{stage}/，只列该章笔记。
 */
const { stages, all: notes } = getAllNotes();
---

<BaseLayout
  title="所有笔记"
  description="覆盖散户投资认知、技术分析、财报估值、仓位管理、跨市场资产配置等 14 个章节，共 115 篇投资笔记。"
>
  <section class="container container--narrow">
    <header class="page-header">
      <p class="page-header__eyebrow">NOTES · 投资笔记合集</p>
      <h1>所有笔记</h1>
      <p class="page-header__lead">
        共 <strong>{notes.length}</strong> 篇笔记，按章节（S00-S13）分组排列。
        每篇均为独立深色主题 HTML 页面，包含完整的目录、案例与图表。
      </p>
    </header>

    {stages.map((stage) => (
      <section class="stage-group" id={stage.id}>
        <h2 class="stage-group__title">
          <span class="stage-group__id">{stage.id}</span>
          <a class="stage-group__name" href={`/notes/${stage.id}/`}>{stage.title}</a>
          <span class="stage-group__count">{stage.notes.length} 篇</span>
        </h2>
        <ol class="note-list">
          {stage.notes.map((note) => (
            <li>
              <a class="note-list__link" href={`/notes/${note.slug}`}>
                <span class="note-list__num">{note.num}</span>
                <span class="note-list__title">{note.title}</span>
                <span class="note-list__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="stage-group__more" href={`/notes/${stage.id}/`}>
          只看本章 {stage.notes.length} 篇 →
        </a>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-default);
  }

  .page-header__eyebrow {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .page-header h1 {
    margin: 0 0 var(--space-3);
    font-size: 2.25rem;
    letter-spacing: -0.02em;
  }

  .page-header__lead {
    margin: 0;
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .stage-group {
    margin-bottom: var(--space-10);
  }

  .stage-group__title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--accent);
    font-size: 1.25rem;
  }

  .stage-group__id {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-subtle);
    padding: 2px 10px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .stage-group__name {
    flex: 1;
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .stage-group__name:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .stage-group__count {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .stage-group__more {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
  }

  .stage-group__more:hover {
    text-decoration: underline;
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .note-list li {
    margin: 0;
    border-bottom: 1px dashed var(--border-default);
  }

  .note-list li:last-child {
    border-bottom: none;
  }

  .note-list__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .note-list__link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .note-list__num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent);
    min-width: 28px;
    flex-shrink: 0;
  }

  .note-list__title {
    flex: 1;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .note-list__arrow {
    color: var(--text-muted);
    font-size: 0.875rem;
    opacity: 0;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .note-list__link:hover .note-list__arrow {
    opacity: 1;
    transform: translateX(4px);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .page-header h1 { font-size: 1.875rem; }
    .stage-group__title { font-size: 1.125rem; flex-wrap: wrap; }
  }
</style>
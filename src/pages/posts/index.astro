---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts } from '../../utils';

const posts = await getSortedPosts();

// 按年份分组
const grouped = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(post);
}
const years = [...grouped.keys()].sort((a, b) => b - a);
---

<BaseLayout title="所有文章" description="按时间倒序排列的全部文章列表。">
  <section class="container container--narrow">
    <header class="page-header">
      <h1>所有文章</h1>
      <p class="page-header__lead">共 {posts.length} 篇，按发布时间倒序排列。</p>
    </header>

    {years.map((year) => (
      <section class="year-group">
        <h2 class="year-group__title">{year}</h2>
        <div class="year-group__list">
          {grouped.get(year)!.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    ))}

    {posts.length === 0 && (
      <p class="empty">还没有任何文章。</p>
    )}
  </section>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-default);
  }

  .page-header h1 {
    margin: 0 0 var(--space-3);
    font-size: 2rem;
  }

  .page-header__lead {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .year-group {
    margin-bottom: var(--space-12);
  }

  .year-group__title {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding: 0 var(--space-3);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
  }

  .year-group__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .empty {
    text-align: center;
    padding: var(--space-12);
    color: var(--text-muted);
  }
</style>
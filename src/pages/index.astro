---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { getAllNotes } from '../utils/notes';

// 笔记章节预览：卡片只展示章节名（不含"·"后的副标题）
const { stages, all: allNotes } = getAllNotes();
const totalNotes = allNotes.length;
const stagePreview = stages.map((s) => ({
  id: s.id,
  title: s.title.split(' · ')[0],
  count: s.notes.length,
  firstTitle: s.notes[0]?.title ?? '',
}));
---

<BaseLayout>
  <section class="hero">
    <div class="container container--narrow">
      <p class="hero__eyebrow">{SITE.titleEn}</p>
      <h1 class="hero__title">{SITE.title}</h1>
      <p class="hero__lead">
        一个散户的 <span class="up">实战复盘</span> 与 <span class="down">指标笔记</span>。
        只记录真实下过的单、走过的弯路、以及仍然有效的思考方式。
      </p>
      <p class="hero__notice">
        ⚠️ 本站仅作学习交流，<strong>不构成任何投资建议</strong>。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section__header">
        <h2>投资笔记</h2>
        <a class="section__more" href="/notes/">查看全部 {totalNotes} 篇 →</a>
      </header>
      <p class="section__lead">
        按章节（S00-S13）系统整理的 {totalNotes} 篇投资笔记，覆盖散户认知、技术指标、财报估值、仓位管理、市场周期与情绪等主题。
      </p>
      <div class="note-stage-grid">
        {stagePreview.map((stage) => (
          <a class="note-stage-card" href={`/notes/?stage=${stage.id}`}>
            <div class="note-stage-card__head">
              <span class="note-stage-card__id">{stage.id}</span>
              <span class="note-stage-card__count">{stage.count} 篇</span>
            </div>
            <h3 class="note-stage-card__title">{stage.title}</h3>
            <p class="note-stage-card__sample">{stage.firstTitle}</p>
            <span class="note-stage-card__arrow" aria-hidden="true">只看本章 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-12) 0 var(--space-16);
    text-align: center;
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3);
  }
  .hero__title {
    margin: 0 0 var(--space-4);
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .hero__lead {
    margin: 0 auto var(--space-4);
    max-width: 36em;
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .hero__notice {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .section {
    margin: var(--space-16) 0;
  }
  .section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .section__header h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .section__more {
    font-size: 0.9375rem;
    color: var(--accent);
  }
  .section__lead {
    margin: 0 0 var(--space-6);
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .note-stage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .note-stage-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }
  .note-stage-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .note-stage-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }
  .note-stage-card__id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-subtle);
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .note-stage-card__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .note-stage-card__title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .note-stage-card__sample {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .note-stage-card__arrow {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 500;
  }
  @media (max-width: 640px) {
    .hero__title { font-size: 2.25rem; }
    .hero { padding: var(--space-8) 0 var(--space-12); }
    .note-stage-grid { grid-template-columns: 1fr; }
  }</style>